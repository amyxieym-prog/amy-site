---
import Base from '../../layouts/Base.astro';
import {publishedBlog,formatDate} from '../../lib/content';
const entries=await publishedBlog();const categories=[...new Set(entries.map(e=>e.data.category))];
---
<Base title="心启花开 · 文章｜议敏 Amy"><section class="section page-heading"><p class="eyebrow">INTREASURE / 心启花开 · 文章</p><h1>心启花开 · 文章</h1><p>把理解带进生活，让成长有方向，也有温度。</p></section><section class="section listing"><div class="filters"><button class="is-active" data-filter="all" aria-pressed="true">全部</button>{categories.map(c=><button data-filter={c} aria-pressed="false">{c}</button>)}</div><div class="card-grid">{entries.map(e=><a class="card" data-category={e.data.category} href={'/blog/'+e.id+'/'}><p class="eyebrow">{e.data.category}</p><h2>{e.data.title}</h2><p>{e.data.description}</p><span class="card-bottom">{formatDate(e.data.publishDate)} · 阅读 ↗</span></a>)}</div></section></Base>