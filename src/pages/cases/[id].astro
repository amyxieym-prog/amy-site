---
import {render} from 'astro:content';
import Base from '../../layouts/Base.astro';
import Contact from '../../components/Contact.astro';
import {publishedCases,formatDate} from '../../lib/content';
export async function getStaticPaths(){return (await publishedCases()).map(entry=>({params:{id:entry.id},props:{entry}}));}
const {entry}=Astro.props; const {Content,headings}=await render(entry);
---
<Base title={entry.data.title+'｜议敏 Amy'} description={entry.data.description} type="article"><article class="article-shell"><header class="article-header"><a class="text-link" href="/cases/">← 实践案例</a><p class="eyebrow">{entry.data.category}</p><h1>{entry.data.title}</h1><p class="article-description">{entry.data.description}</p><p class="article-meta">议敏 Amy · 网站发布 {formatDate(entry.data.publishDate)}</p></header><div class="article-grid"><aside><p class="eyebrow">本文目录</p>{headings.filter(h=>h.depth===2).map(h=><a href={'#'+h.slug}>{h.text}</a>)}</aside><div class="prose"><Content /><div class="observation"><h3>{entry.data.result}</h3><p>{entry.data.boundary}</p></div><p class="source-note">案例经脱敏整理，省略姓名、学校等可识别信息。</p><hr /><a class="text-link" href="/cases/">继续阅读 ↗</a></div></div></article><Contact /></Base>