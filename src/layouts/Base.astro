---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
interface Props { title?: string; description?: string; image?: string; type?: 'website' | 'article'; noindex?: boolean; }
const { title = '议敏 Amy｜在学习中，长出自己的力量', description = '学习赋能教练、家庭幸福力教练与终身学习者。以 RISE 框架看清学习卡点，支持学习者认领行动，在真实反馈中成长。', image = '/assets/amy-portrait.webp', type = 'website', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#123f32" /><meta name="description" content={description} /><title>{title}</title><link rel="canonical" href={canonical} /><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" /><link rel="alternate" type="application/rss+xml" title="心启花开 · Amy 的文章" href="/rss.xml" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content={type} /><meta property="og:url" content={canonical} /><meta property="og:image" content={new URL(image, Astro.site)} />{noindex && <meta name="robots" content="noindex" />}<slot name="head" /></head><body><a class="skip-link" href="#main">跳到主要内容</a><Header /><main id="main"><slot /></main><Footer /><div id="toast" class="toast" role="status" aria-live="polite"></div><dialog id="prepare-dialog" aria-labelledby="prepare-title"><div class="dialog-top"><p class="eyebrow">从真实场景开始</p><button data-close-dialog aria-label="关闭清单">×</button></div><h2 id="prepare-title">带着观察，开始一次沟通。</h2><p>先整理下面几件事，再决定希望获得怎样的支持。这份清单不会收集或提交你的信息。</p><ol><li>最近遇到的一个具体学习场景。</li><li>当时说了什么、做了什么。</li><li>你怎样回应，之后发生了什么。</li><li>尝试过什么，观察到哪些变化。</li><li>最希望这次沟通厘清的一件事。</li></ol><button class="button button-green" data-copy-checklist>复制沟通清单 ↗</button></dialog><script>import '../scripts/interactions.ts';</script></body></html>
